plot(sim[[1]], col = 'black', cex = 0.5, add = TRUE)
sim = simulate(model)
plot(elev, main = NULL)
plot(sim[[1]], col = 'black', cex = 0.5, add = TRUE)
sim = simulate(model)
plot(elev, main = NULL)
plot(sim[[1]], col = 'black', cex = 0.5, add = TRUE)
