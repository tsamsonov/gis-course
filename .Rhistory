data(bei.extra)
elev = bei.extra[[1]] # высота
grad = bei.extra[[2]] # градиент (уклон)
plot(elev, main = NULL)
plot(bei, add = TRUE)
plot(grad, main = NULL)
plot(bei, add = TRUE)
model = ppm(bei ~ offset(log(grad)), data = bei.extra)
plot(model, how = "image", se = FALSE, main = NULL)
sim = simulate(model)
plot(elev, main = NULL)
plot(sim[[1]], col = 'black', cex = 0.5, add = TRUE)
sim = simulate(model)
plot(elev, main = NULL)
plot(sim[[1]], col = 'black', cex = 0.5, add = TRUE)
sim = simulate(model)
