adm = read_sf(ne, 'ne_50m_admin_0_countries')
china = filter(adm, ISO_A3 == 'CHN')
pop_china = pop[china, ]
ggplot() +
geom_sf(data = china, fill = 'khaki1') +
geom_sf(data = pop_china)
